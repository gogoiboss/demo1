{
  "framework": null,
  "headers": [
    {
      "source": "/dashboard/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/eta/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://demo1-production-b538.up.railway.app/api/$1" },
    { "source": "/predict/(.*)", "destination": "https://demo1-production-b538.up.railway.app/predict/$1" },
    { "source": "/health", "destination": "https://demo1-production-b538.up.railway.app/health" },
    { "source": "/system/(.*)", "destination": "https://demo1-production-b538.up.railway.app/system/$1" },
    { "source": "/trains", "destination": "https://demo1-production-b538.up.railway.app/trains" },
    { "source": "/graph/(.*)", "destination": "https://demo1-production-b538.up.railway.app/graph/$1" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/dashboard/$1" },
    { "source": "/eta/(.*)", "destination": "/eta/$1" },
    { "source": "/", "destination": "/eta/index.html" },
    { "source": "/three.min.js", "destination": "/eta/three.min.js" },
    { "source": "/GLTFLoader.js", "destination": "/eta/GLTFLoader.js" },
    { "source": "/wap7_model_data.js", "destination": "/eta/wap7_model_data.js" },
    { "source": "/wap7.glb", "destination": "/eta/wap7.glb" },
    { "source": "/assetes/(.*)", "destination": "/eta/assetes/$1" },
    { "source": "/privacy.html", "destination": "/eta/privacy.html" },
    { "source": "/(.*)", "destination": "/eta/$1" }
  ]
}

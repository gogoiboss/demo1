# Optional live RailRadar credential. Keep the real value in .env or CI secrets.
RIPPLEETA_API_KEY=
RIPPLEETA_MODE=replay

# Required in any real deployment so login sessions survive a process
# restart. If unset, src/api/auth.py generates a fresh random secret per
# process start rather than falling back to a value baked into the source
# (see the comment there) — safe, but every restart invalidates sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Required for real Google sign-in; leave unset to keep demo-login-only mode.
GOOGLE_CLIENT_ID=